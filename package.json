{
  "name": "sri-suriya-polymers-app",
  "version": "2.1.0",
  "description": "Sri Suriya Polymers - complete business web application (public site, admin CMS, 3D/particles/sound, SEO, security)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "start:cluster": "node cluster.js",
