# ───────────────────────────────────────────────────────────────
#  Sri Suriya Polymers – settings file
#  1. Copy this file to  .env   (cp .env.example .env)
#  2. Fill in the values you need. Everything is optional for a
#     local test; the first four matter when you go live.
# ───────────────────────────────────────────────────────────────

# Local test = development. Live website = production.
NODE_ENV=development

# Your public website address, no trailing slash.  (used for SEO, sitemap, e-mails, secure cookies)
SITE_URL=http://localhost:3000

# Port the app listens on (many hosts set this for you automatically).
PORT=3000

# Comma-separated list of domain names this site answers to (blocks Host-header attacks).
# Example: ALLOWED_HOSTS=srisuriyapolymers.com,www.srisuriyapolymers.com
ALLOWED_HOSTS=

# Behind a proxy / load balancer / Render / Railway / Nginx?  1 = trust one proxy hop (recommended in production).
TRUST_PROXY=

# Long random text used to sign and encrypt data. If empty, one is generated in data/.secret.
# Set it explicitly on hosts that wipe the disk on every deploy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# First-run admin account (used only when the database has no users yet).
# If ADMIN_PASSWORD is empty a random one is printed ONCE in the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin panel address. Change it to something less guessable if you like, e.g. manage-7f3k  (then sign in at /manage-7f3k)
ADMIN_PATH=admin

# Optional: only these IP addresses may open the admin panel (comma separated). Leave empty unless you have a fixed IP.
ADMIN_IP_ALLOW=

# Max upload size in MB for the media library.
UPLOAD_MAX_MB=8

# Number of worker processes when using  npm run start:cluster  (0 = automatic, up to 4).
WORKERS=0

# Where data lives (database) and where uploaded files are stored. Mount a persistent disk here on cloud hosts.
# Pictures and videos you upload in Admin -> Media go to public/assets/uploads by default (the assets folder of this project).
DATA_DIR=data
UPLOAD_DIR=public/assets/uploads
# Largest video you may upload from the admin (MB). Bigger files: upload to Google Drive and paste the link.
VIDEO_MAX_MB=60

# ---- VERCEL / CLOUD DATABASE (only needed when you deploy on Vercel) -------------------------------
# Vercel has no permanent disk, so the database must live in the cloud. Create a free database at https://turso.tech
# and paste its address and token here (and into Vercel -> Settings -> Environment Variables).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# auto = use Turso when the two lines above are filled, otherwise local SQLite.   (better-sqlite3 | libsql | auto)
DB_DRIVER=auto
# How often (seconds) a running server re-reads the cloud database to see changes made by other servers.
DB_SYNC_SECONDS=15

# ---- SUPABASE (keeps a copy of ALL your website text data; see docs/INTEGRATIONS.md, step 2) ---------
# 1) Supabase -> SQL Editor -> run docs/supabase/schema.sql   2) paste the two values below (and into Vercel).
# SUPABASE_SERVICE_KEY is a SERVER secret (Project Settings -> API Keys -> "secret" key). Never use the "publishable / anon" key here,
# never put the secret key in browser code, and never commit your .env file.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- E-MAIL (EmailJS) --------------------------------------------------------------------------------
# No environment variables needed: open Admin -> Settings -> Forms, Email & Spam and fill in your Gmail address and the
# EmailJS Service ID, Template ID, Public Key and Private Key. Guide: docs/EMAILJS.md

# ---- GOOGLE DRIVE UPLOADS (optional, see docs/GOOGLE_DRIVE.md) -------------------------------------
# After you deploy the small Apps Script from docs/drive/Code.gs, paste its web-app address and your secret key here
# (or in Admin -> Settings -> Media & Storage). Without these, pasting public Drive links still works.
DRIVE_SCRIPT_URL=
DRIVE_ADMIN_KEY=

# Request limits are per visitor IP. If many real visitors share one public IP (school, office, mobile network), raise this (1–50).
RATE_LIMIT_MULTIPLIER=1
