    "helmet": "^8.3.0",
    "libsql": "0.5.29",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
